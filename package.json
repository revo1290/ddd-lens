{
  "name": "ddd-lens",
  "version": "0.1.0",
  "description": "Evidence-based DDD fitness assessment for Japanese teams",
  "type": "module",
  "bin": {
    "ddd-lens": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage.enabled",
    "test:watch": "vitest",
    "lint": "eslint .",
    "ci": "npm run check && npm run lint && npm test && npm run build",
    "prepack": "npm run ci"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "architecture",
    "static-analysis",
    "japanese"
  ],
  "author": "revo1290",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revo1290/ddd-lens.git"
  },
  "bugs": {
    "url": "https://github.com/revo1290/ddd-lens/issues"
  },
  "homepage": "https://github.com/revo1290/ddd-lens#readme",
  "dependencies": {
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.11"
  }
}
